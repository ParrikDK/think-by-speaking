# Speak, Don't Just Read v10 backend — example environment file.
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── API keys (required for real LLM/STT/TTS calls) ──
ELEVENLABS_API_KEY=
DEEPSEEK_API_KEY=
# Tutor turns. deepseek-chat / deepseek-reasoner / deepseek-flash were
# retired 2026-07-24 — the app warns loudly at startup if one is set.
DEEPSEEK_MODEL=deepseek-v4-pro
# Cheap internal calls (language-drift nudge retry).
DEEPSEEK_MODEL_FAST=deepseek-v4-flash

# ── App ──
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8004
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ── Database ──
DATABASE_URL=sqlite:///./speaking_tutor.db

# ── Sessions ──
SESSION_TTL_MINUTES=30
FLUSH_INTERVAL_SECONDS=10

# ── Auth ──
TOKEN_TTL_DAYS=30

# ── Limits ──
MAX_AUDIO_BYTES=26214400
RATE_LIMIT_PER_MINUTE=60

# ── Outbound timeouts (seconds) ──
LLM_STREAM_RETRIES=2
# LLM_TIMEOUT_SECONDS=45
TTS_TIMEOUT_SECONDS=30
STT_TIMEOUT_SECONDS=30

# ── TTS provider per language ──
# Edge-tts is primary for every language. Languages listed here flip the
# chain: ElevenLabs runs FIRST for them, edge-tts is their fallback.
ELEVENLABS_PRIMARY_LANGUAGES=

# ── Realtime speech-to-speech (v11 M1) ──
# DashScope qwen3.5-omni realtime bridge (app/realtime/). Get a key at
# modelstudio.console.alibabacloud.com. Without it /api/realtime/ws errors.
DASHSCOPE_API_KEY=
# DASHSCOPE_REALTIME_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
# Per-connection audio cap (upstream hard cap is 600s — we roll early).
REALTIME_MAX_AUDIO_SECONDS=540
# Guest trial (per IP per day) and registered-user daily quota.
REALTIME_GUEST_TRIAL_SECONDS=120
REALTIME_DAILY_MINUTES=30
REALTIME_MAX_CONCURRENT_PER_IP=2
